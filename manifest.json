{
  "manifest_version": 3,
  "name": "Mise",
  "description": "Fill reusable work prompts with browser context and copy the finished text to paste into an AI chat.",
  "version": "0.0.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "clipboardWrite"
  ],
  "optional_permissions": [
    "clipboardRead",
    "tabs"
  ],
  "action": {
    "default_popup": "palette.html?popup",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "omnibox": {
    "keyword": "mise"
  },
  "commands": {
    "open-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+1",
        "mac": "Command+Shift+1"
      },
      "description": "Open Mise",
      "global": true
    }
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
